{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Caracal",
	"fileTypes": [
		"cara"
	],
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#annotations" },
		{ "include": "#type-definition" },
		{ "include": "#function-definition" },
		{ "include": "#keywords" },
		{ "include": "#types" },
		{ "include": "#boolean" },
		{ "include": "#discard" },
		{ "include": "#function-call" },
		{ "include": "#numbers" },
		{ "include": "#operators" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.caracal",
					"begin": "//",
					"end": "$"
				},
				{
					"name": "comment.block.caracal",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.caracal",
			"begin": "\"",
			"end": "\"|(?=$)",
			"patterns": [
				{
					"name": "constant.character.escape.caracal",
					"match": "\\\\[abfnrtv'\"\\\\]"
				}
			]
		},
		"annotations": {
			"match": "(#)([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": { "name": "punctuation.definition.annotation.caracal" },
				"2": { "name": "entity.name.function.decorator.caracal" }
			}
		},
		"type-definition": {
			"match": "\\b(type|enum)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": { "name": "storage.type.caracal" },
				"2": { "name": "entity.name.type.caracal" }
			}
		},
		"function-definition": {
			"patterns": [
				{
					"match": "\\b(def)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "storage.type.function.caracal" },
						"2": { "name": "entity.name.type.caracal" },
						"3": { "name": "punctuation.accessor.caracal" },
						"4": { "name": "entity.name.function.caracal" }
					}
				},
				{
					"match": "\\b(def)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "storage.type.function.caracal" },
						"2": { "name": "entity.name.function.caracal" }
					}
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.caracal",
					"match": "\\b(if|else|while|return|break|skip)\\b"
				},
				{
					"name": "storage.type.function.caracal",
					"match": "\\bdef\\b"
				},
				{
					"name": "storage.type.function.caracal",
					"match": "\\btest\\b(?=\\s*\")"
				},
				{
					"name": "storage.type.caracal",
					"match": "\\b(type|enum)\\b"
				},
				{
					"name": "keyword.operator.logical.caracal",
					"match": "\\b(and|or)\\b"
				},
				{
					"name": "storage.modifier.ref.caracal",
					"match": "\\bref\\b"
				}
			]
		},
		"types": {
			"name": "support.type.primitive.caracal",
			"match": "\\b(void|bool|u8|i32|f32|cstring)\\b"
		},
		"boolean": {
			"name": "constant.language.boolean.caracal",
			"match": "\\b(true|false)\\b"
		},
		"discard": {
			"name": "variable.language.discard.caracal",
			"match": "\\b_\\b"
		},
		"function-call": {
			"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
			"captures": {
				"1": { "name": "entity.name.function.caracal" }
			}
		},
		"numbers": {
			"name": "constant.numeric.caracal",
			"match": "\\b\\d[\\d_]*(\\.[\\d_]+)?\\b"
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.comparison.caracal",
					"match": "==|!=|<=|>=|<|>"
				},
				{
					"name": "keyword.operator.assignment.caracal",
					"match": "="
				},
				{
					"name": "keyword.operator.logical.caracal",
					"match": "!"
				},
				{
					"name": "keyword.operator.arithmetic.caracal",
					"match": "[+\\-*/]"
				},
				{
					"name": "keyword.operator.type.caracal",
					"match": "'"
				}
			]
		}
	},
	"scopeName": "source.caracal"
}
