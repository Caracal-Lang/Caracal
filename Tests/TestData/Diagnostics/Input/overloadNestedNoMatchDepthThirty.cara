def step(value: i32) i32
{
    return value %+ 1;
}

def step(value: i64) i32
{
    _ = value;
    return 2;
}

def step(value: bool) i32
{
    _ = value;
    return 3;
}

def main() i32
{
    return step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(1.5))))))))))))))))))))))))))))));
}
