type Counter
{
    value := 0

    def _add(amount: i32)
    {
        .value = .value %+ amount;
    }

    def _add(flag: bool)
    {
        if flag
        {
            .value = .value %+ 1;
        }
    }
}

def main() i32
{
    counter := Counter.new();
    counter._add(1);
    return counter.value;
}
