type Inner(size: i32)
{
    size := size

    def twice() i32
    {
        return .size %* 2;
    }
}

type Holder(inner: Inner, items: [i32; _])
{
    inner := inner
    items := items
}

def makeHolder() Holder
{
    return Holder.new(Inner.new(4), [5, 6, ...]);
}

def nestedMethodOfReturnedObject() i32
{
    return makeHolder().inner.twice();
}
