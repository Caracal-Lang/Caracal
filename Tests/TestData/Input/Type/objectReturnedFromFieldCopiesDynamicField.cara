type Holder(items: [i32; _])
{
    items := items
}

type Outer(holder: Holder)
{
    holder := holder

    def holderCopy() Holder
    {
        return .holder;
    }
}

def objectReturnedFromFieldCopiesDynamicField() i32
{
    outer := Outer.new(Holder.new([5, 6, ...]));
    other := outer.holderCopy();
    other.items.set(0, 9);
    return outer.holder.items.at(0);
}
