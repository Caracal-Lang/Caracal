type Inner(size: i32)
{
    size := size

    def twice() i32
    {
        return .size %* 2;
    }
}

type Holder(inner: Inner, items: [i32; _], name: string)
{
    inner := inner
    items := items
    name := name
}

def makeHolder() Holder
{
    items : [i32; _] = [5, 6, ...];
    return Holder.new(Inner.new(4), items, "name");
}

def bump(value: ref i32)
{
    value = value %+ 1;
}

def refOfNestedField() i32
{
    holder := makeHolder();
    bump(ref holder.inner.size);
    return holder.inner.size;
}
