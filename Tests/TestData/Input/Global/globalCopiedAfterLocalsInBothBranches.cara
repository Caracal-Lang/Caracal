numbers :: init [i32; _];

def globalCopiedAfterLocalsInBothBranches(condition: bool) i32
{
    if condition
    {
        numbers := [1, ...];
        _ = numbers.at(0);
    }
    else
    {
        numbers := [2, ...];
        _ = numbers.at(0);
    }
    copy := numbers;
    return copy.at(0);
}

def main() i32
{
    numbers = [5, ...];
    return globalCopiedAfterLocalsInBothBranches(false);
}
