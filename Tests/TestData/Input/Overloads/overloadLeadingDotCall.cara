type Counter
{
    value := 0

    def add(amount: i32)
    {
        .value = .value %+ amount;
    }

    def add(flag: bool)
    {
        if flag
        {
            .value = .value %+ 10;
        }
    }

    def addBoth()
    {
        .add(2);
        .add(true);
    }
}

def main() i32
{
    counter := Counter.new();
    counter.addBoth();
    return counter.value;
}
