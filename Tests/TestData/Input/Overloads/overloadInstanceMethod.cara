type Counter
{
    value := 0

    def add(amount: i32)
    {
        .value = .value %+ amount;
    }

    def add(flag: bool)
    {
        if flag
        {
            .value = .value %+ 10;
        }
    }

    def add(left: i32, right: i32)
    {
        .value = .value %+ left %* right;
    }
}

def main() i32
{
    counter := Counter.new();
    counter.add(1);
    counter.add(true);
    counter.add(3, 4);
    return counter.value;
}
