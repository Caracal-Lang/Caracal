type Point(x: i32)
{
    x := x
}

type Size(width: i32)
{
    width := width
}

def measure(point: Point) i32
{
    return point.x;
}

def measure(size: Size) i32
{
    return size.width %* 10;
}

def main() i32
{
    point := Point.new(3);
    size := Size.new(4);
    return measure(point) %+ measure(size);
}
