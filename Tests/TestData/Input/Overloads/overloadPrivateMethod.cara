type Counter
{
    value := 0

    def _add(amount: i32)
    {
        .value = .value %+ amount;
    }

    def _add(flag: bool)
    {
        if flag
        {
            .value = .value %+ 10;
        }
    }

    def merge(other: Counter)
    {
        ._add(other.value);
        copy := other;
        copy._add(true);
        .value = .value %+ copy.value;
    }
}

def main() i32
{
    first := Counter.new();
    second := Counter.new();
    second.value = 3;
    first.merge(second);
    return first.value;
}
