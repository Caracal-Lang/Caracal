def checkSum(Test: ref TestRun, left: i32, right: i32)
{
    Test.isTrue(left %+ right == 4, "the sum is four");
}

test "both checks"
{
    value := 2;
    Test.isTrue(value == 2);
    Test.isFalse(value == 3, "value is not three");
}

test "a helper checks"
{
    checkSum(Test, 2, 2);
}

def main() i32
{
    return 0;
}
